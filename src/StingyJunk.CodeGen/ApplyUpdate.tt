<#	
	string m_configFilePath = @".\CodeGen.config";
	XDocument m_cfg = XDocument.Load(m_configFilePath);
	XElement m_dbConnEleVT = m_cfg.Descendants("databaseConnectionString").First();
	string m_connStr = m_dbConnEleVT.Value;
	XElement m_tablesEle = m_cfg.Descendants("tables").First();
	string m_columnQuery = @"SELECT COLUMN_NAME, DATA_TYPE, IS_NULLABLE FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME = '{0}' AND COLUMN_NAME NOT LIKE '%RMGT%' ORDER BY ORDINAL_POSITION	";

	List<TableGen> m_tables = new List<TableGen>();
	List<TableData> m_classes = new List<TableData>();
	
	foreach (XElement _tableEle in m_tablesEle.Descendants())
	{
		
		string _tableName = _tableEle.Attribute("tableName").Value;
		string _namespaceName = _tableEle.Attribute("namespaceName").Value;
		string _className = _tableEle.Attribute("className").Value;
		bool _sdc = false;
		XAttribute _suppressDefaultCtor = _tableEle.Attribute("suppressDefaultConstructor");
		if (_suppressDefaultCtor != null)
		{
			_sdc = Convert.ToBoolean(_suppressDefaultCtor.Value);
		}

		XAttribute _serAttr = _tableEle.Attribute("serializable");
		bool _serializable = false;
		if(_serAttr != null)
		{_serializable = Boolean.Parse(_tableEle.Attribute("serializable").Value);}

		m_tables.Add(new TableGen(_tableName, _namespaceName, _className,_serializable, _sdc));
	}


	using (SqlConnection _conn = new SqlConnection(m_connStr))
	{
		_conn.Open();

		foreach (TableGen _tgen in m_tables)
		{
			TableData _td = new TableData(_tgen);

			SqlCommand _cmd = new SqlCommand(String.Format(m_columnQuery, _tgen.TableName), _conn);
			SqlDataReader _rdr = _cmd.ExecuteReader();

			while (_rdr.Read())
			{
				ColumnData _cd = new ColumnData();
				_cd.ColumnName = Convert.ToString(_rdr["COLUMN_NAME"]);
				_cd.PropertyName = MakeIdentifierSafeName(_cd.ColumnName);
				_cd.DataType = DeriveTypeName(Convert.ToString(_rdr["DATA_TYPE"]));
				string _isNullable = Convert.ToString(_rdr["IS_NULLABLE"]);
				if (_isNullable.Equals("YES", StringComparison.OrdinalIgnoreCase))
				{
					_cd.IsNullable = true;
				}
				if (_cd.ColumnName.EndsWith("SeqID", StringComparison.OrdinalIgnoreCase) 
					&& _cd.DataType == "Guid")
				{
					_cd.IsNullable = true;
				}
								
				_td.Columns.Add(_cd);
			} //end while

			_rdr.Close();
			m_classes.Add(_td);
		} 

	} //end using 

