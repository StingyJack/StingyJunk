<#@ include file=".\GenerationHelpers.ttinclude" #>
<#	
	string _ConfigFilePath = Host.ResolvePath("CodeGen.config");
	XDocument _Cfg = XDocument.Load(_ConfigFilePath);
	XElement _DbConnEle = _Cfg.Descendants("databaseConnectionString").First();
	string _ConnStr = _DbConnEle.Value;
	XElement _TablesEle = _Cfg.Descendants("tables").First();
	string _ColumnQuery = @"SELECT COLUMN_NAME, DATA_TYPE, IS_NULLABLE FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME = '{0}' ORDER BY ORDINAL_POSITION	";

	List<TableGen> _Tables = new List<TableGen>();
	List<TableData> _ClassDefs = new List<TableData>();
	
	foreach (XElement _tableEle in _TablesEle.Descendants())
	{
		
		string _tableName = _tableEle.Attribute("tableName").Value;
		string _namespaceName = _tableEle.Attribute("namespaceName").Value;
		string _className = _tableEle.Attribute("className").Value;
		bool _sdc = false;
		XAttribute _suppressDefaultCtor = _tableEle.Attribute("suppressDefaultConstructor");
		if (_suppressDefaultCtor != null)
		{
			_sdc = Convert.ToBoolean(_suppressDefaultCtor.Value);
		}

		XAttribute _serAttr = _tableEle.Attribute("serializable");
		bool _serializable = false;
		if(_serAttr != null)
		{_serializable = Boolean.Parse(_tableEle.Attribute("serializable").Value);}

		_Tables.Add(new TableGen(_tableName, _namespaceName, _className,_serializable, _sdc));
	}


	using (SqlConnection _conn = new SqlConnection(_ConnStr))
	{
		_conn.Open();

		foreach (TableGen _tgen in _Tables)
		{
			TableData _td = new TableData(_tgen);

			SqlCommand _cmd = new SqlCommand(String.Format(_ColumnQuery, _tgen.TableName), _conn);
			SqlDataReader _rdr = _cmd.ExecuteReader();

			while (_rdr.Read())
			{
				ColumnData _cd = new ColumnData();
				_cd.ColumnName = Convert.ToString(_rdr["COLUMN_NAME"]);
				_cd.PropertyName = MakeIdentifierSafeName(_cd.ColumnName);
				_cd.DataType = DeriveTypeName(Convert.ToString(_rdr["DATA_TYPE"]));
				string _isNullable = Convert.ToString(_rdr["IS_NULLABLE"]);
				if (_isNullable.Equals("YES", StringComparison.OrdinalIgnoreCase)
					|| (_cd.ColumnName == "SeqID" && _cd.DataType == "Guid"))
				{
					_cd.IsNullable = true;
				}
								
				_td.Columns.Add(_cd);
			} //end while

			_rdr.Close();
			_ClassDefs.Add(_td);
		} 

	} //end using 

#>
