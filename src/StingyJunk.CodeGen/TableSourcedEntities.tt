	#region "helper methods"
namespace My.Codegen.Common {
	///<summary>Some minor utilities</summary>
	public static class CodeGenUtils
	{

		///<summary>Converts a dataRowcolumn to a timespan</summary>
		internal static TimeSpan? ConvertToTimeSpan(object dataRowColumn)
		{
			if (dataRowColumn == null)
			{
				return null;
			}

			return TimeSpan.Parse(dataRowColumn.ToString());	
		}
	}
}
